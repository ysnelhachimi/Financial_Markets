# Backend web — copier en `.env`. Aucune valeur sensible n'est codée en dur.

# Application
KWEB_APP_NAME=Kanyon Markets
KWEB_ENVIRONMENT=development
KWEB_DEBUG=true

# Base applicative (comptes, abonnements, paiements)
KWEB_DATABASE_URL=sqlite:///./kanyon_web.db

# Sécurité — GÉNÉRER une clé forte en production (ex. `openssl rand -hex 32`)
KWEB_SECRET_KEY=change-me-in-production
KWEB_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend autorisé (CORS)
KWEB_CORS_ORIGINS=["http://localhost:5173"]

# Essai gratuit à l'inscription (jours)
KWEB_TRIAL_DAYS=14

# Paiement : "cmi" (production) ou "fake" (dev/tests)
KWEB_PAYMENT_PROVIDER=fake
KWEB_CMI_CLIENT_ID=
KWEB_CMI_STORE_KEY=
KWEB_CMI_GATEWAY_URL=https://payment.cmi.co.ma/fim/est3Dgate
KWEB_PUBLIC_BASE_URL=http://localhost:8000
KWEB_FRONTEND_BASE_URL=http://localhost:5173

# Données de marché servies par le package kanyon
KANYON_DATABASE_URL=sqlite:///./kanyon_data.db
