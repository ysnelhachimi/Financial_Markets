# Configuration de la stack Docker (copier en `.env`).

# PostgreSQL
POSTGRES_USER=kanyon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kanyon

# Backend — GÉNÉRER une clé forte en production : openssl rand -hex 32
KWEB_SECRET_KEY=change-me-in-production
KWEB_TRIAL_DAYS=14

# Paiement : "fake" (démo) ou "cmi" (production).
KWEB_PAYMENT_PROVIDER=fake
KWEB_CMI_CLIENT_ID=
KWEB_CMI_STORE_KEY=
