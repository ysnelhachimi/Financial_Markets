# Copier en `.env` et adapter. Aucune de ces valeurs n'est codée en dur dans le code.

# URL SQLAlchemy de la base de données.
# PostgreSQL (défaut) :
KANYON_DATABASE_URL=postgresql+psycopg2://user:password@127.0.0.1:5432/db_kanyon
# SQLite (alternative sans serveur) :
# KANYON_DATABASE_URL=sqlite:///./data/kanyon.db

# Répertoire de téléchargement des fichiers scrappés.
KANYON_DOWNLOAD_DIR=./data/masi_files

# Mode headless du navigateur Selenium (1 = actif, 0 = fenêtre visible).
KANYON_HEADLESS=1
